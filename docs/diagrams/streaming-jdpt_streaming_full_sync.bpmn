<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_streaming_jdpt"
  targetNamespace="http://jdpt.pt/bpmn/streaming"
  exporter="Camunda Modeler"
  exporterVersion="5.47.0">
  <bpmn:process id="Process_jdpt_streaming_full_sync" name="jdpt_streaming_full_sync" isExecutable="false">
    <bpmn:documentation>Pipeline streaming Flyte — radar NOC de curto prazo (não alimenta Produtos A/B oficiais).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_streaming">
      <bpmn:lane id="Layer_events" name="Layer: Fonte de eventos">
        <bpmn:flowNodeRef>StartEvent_cycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_emit_events</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DataStore_kafka</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Layer_bronze" name="Layer: Bronze streaming">
        <bpmn:flowNodeRef>Task_ingest_kafka</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DataStore_bronze_raw</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Layer_silver" name="Layer: Silver streaming">
        <bpmn:flowNodeRef>Task_bronze_silver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DataStore_silver_clean</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DataStore_checkpoints</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Layer_gold" name="Layer: Gold horária">
        <bpmn:flowNodeRef>Task_silver_gold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DataStore_gold_hourly</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Layer_noc" name="Layer: NOC">
        <bpmn:flowNodeRef>EndEvent_noc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TextAnnotation_note</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>

    <bpmn:startEvent id="StartEvent_cycle" name="Ciclo repetido">
      <bpmn:outgoing>Flow_start_sim</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_emit_events" name="Simulador producer_network_events">
      <bpmn:documentation>Emissão contínua de telemetria JSON para Redpanda/Kafka.</bpmn:documentation>
      <bpmn:incoming>Flow_start_sim</bpmn:incoming>
      <bpmn:outgoing>Flow_sim_kafka</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="DataStore_kafka" name="Redpanda / Kafka&#10;topic network_events" />
    <bpmn:task id="Task_ingest_kafka" name="ingest_kafka_to_bronze">
      <bpmn:documentation>MERGE idempotente por event_id → iceberg.bronze.network_events_raw</bpmn:documentation>
      <bpmn:incoming>Flow_kafka_bronze</bpmn:incoming>
      <bpmn:outgoing>Flow_bronze_store</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="DataStore_bronze_raw" name="iceberg.bronze&#10;network_events_raw" />
    <bpmn:task id="Task_bronze_silver" name="ingest_bronze_to_silver">
      <bpmn:documentation>Limpeza, dedup e watermark → iceberg.silver.network_events_clean</bpmn:documentation>
      <bpmn:incoming>Flow_store_silver_task</bpmn:incoming>
      <bpmn:outgoing>Flow_silver_store</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="DataStore_silver_clean" name="iceberg.silver&#10;network_events_clean" />
    <bpmn:dataStoreReference id="DataStore_checkpoints" name="streaming_checkpoints" />
    <bpmn:task id="Task_silver_gold" name="silver_to_gold_network_events_hourly">
      <bpmn:documentation>Agregação horária RSRP / sinais fracos → iceberg.gold.network_events_hourly</bpmn:documentation>
      <bpmn:incoming>Flow_clean_gold</bpmn:incoming>
      <bpmn:outgoing>Flow_gold_store</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataStoreReference id="DataStore_gold_hourly" name="iceberg.gold&#10;network_events_hourly" />
    <bpmn:endEvent id="EndEvent_noc" name="Radar NOC atualizado">
      <bpmn:incoming>Flow_store_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="TextAnnotation_note">
      <bpmn:text>Nota: complementa o batch com janela de curto prazo; não alimenta Produtos A/B oficiais.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Assoc_note_gold" sourceRef="TextAnnotation_note" targetRef="Task_silver_gold" />
    <bpmn:association id="Assoc_ckpt_silver" sourceRef="DataStore_checkpoints" targetRef="Task_bronze_silver" />

    <bpmn:sequenceFlow id="Flow_start_sim" sourceRef="StartEvent_cycle" targetRef="Task_emit_events" />
    <bpmn:sequenceFlow id="Flow_sim_kafka" sourceRef="Task_emit_events" targetRef="DataStore_kafka" />
    <bpmn:sequenceFlow id="Flow_kafka_bronze" sourceRef="DataStore_kafka" targetRef="Task_ingest_kafka" />
    <bpmn:sequenceFlow id="Flow_bronze_store" sourceRef="Task_ingest_kafka" targetRef="DataStore_bronze_raw" />
    <bpmn:sequenceFlow id="Flow_store_silver_task" sourceRef="DataStore_bronze_raw" targetRef="Task_bronze_silver" />
    <bpmn:sequenceFlow id="Flow_silver_store" sourceRef="Task_bronze_silver" targetRef="DataStore_silver_clean" />
    <bpmn:sequenceFlow id="Flow_clean_gold" sourceRef="DataStore_silver_clean" targetRef="Task_silver_gold" />
    <bpmn:sequenceFlow id="Flow_gold_store" sourceRef="Task_silver_gold" targetRef="DataStore_gold_hourly" />
    <bpmn:sequenceFlow id="Flow_store_end" sourceRef="DataStore_gold_hourly" targetRef="EndEvent_noc" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_streaming">
    <bpmndi:BPMNPlane id="BPMNPlane_streaming" bpmnElement="Process_jdpt_streaming_full_sync">
      <bpmndi:BPMNShape id="Layer_events_di" bpmnElement="Layer_events" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1180" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Layer_bronze_di" bpmnElement="Layer_bronze" isHorizontal="true">
        <dc:Bounds x="160" y="200" width="1180" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Layer_silver_di" bpmnElement="Layer_silver" isHorizontal="true">
        <dc:Bounds x="160" y="320" width="1180" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Layer_gold_di" bpmnElement="Layer_gold" isHorizontal="true">
        <dc:Bounds x="160" y="440" width="1180" height="120" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Layer_noc_di" bpmnElement="Layer_noc" isHorizontal="true">
        <dc:Bounds x="160" y="560" width="1180" height="120" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="StartEvent_cycle_di" bpmnElement="StartEvent_cycle">
        <dc:Bounds x="212" y="122" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="188" y="165" width="85" height="14" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_emit_events_di" bpmnElement="Task_emit_events">
        <dc:Bounds x="300" y="100" width="240" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataStore_kafka_di" bpmnElement="DataStore_kafka">
        <dc:Bounds x="590" y="110" width="160" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_ingest_kafka_di" bpmnElement="Task_ingest_kafka">
        <dc:Bounds x="560" y="220" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataStore_bronze_raw_di" bpmnElement="DataStore_bronze_raw">
        <dc:Bounds x="830" y="230" width="160" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_bronze_silver_di" bpmnElement="Task_bronze_silver">
        <dc:Bounds x="830" y="340" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataStore_silver_clean_di" bpmnElement="DataStore_silver_clean">
        <dc:Bounds x="1100" y="350" width="160" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataStore_checkpoints_di" bpmnElement="DataStore_checkpoints">
        <dc:Bounds x="590" y="350" width="160" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="Task_silver_gold_di" bpmnElement="Task_silver_gold">
        <dc:Bounds x="1100" y="460" width="240" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataStore_gold_hourly_di" bpmnElement="DataStore_gold_hourly">
        <dc:Bounds x="830" y="470" width="160" height="60" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNShape id="EndEvent_noc_di" bpmnElement="EndEvent_noc">
        <dc:Bounds x="892" y="602" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="858" y="645" width="105" height="27" /></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TextAnnotation_note_di" bpmnElement="TextAnnotation_note">
        <dc:Bounds x="1120" y="580" width="200" height="70" />
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Flow_start_sim_di" bpmnElement="Flow_start_sim">
        <di:waypoint x="248" y="140" /><di:waypoint x="300" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_sim_kafka_di" bpmnElement="Flow_sim_kafka">
        <di:waypoint x="540" y="140" /><di:waypoint x="590" y="140" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_kafka_bronze_di" bpmnElement="Flow_kafka_bronze">
        <di:waypoint x="670" y="170" /><di:waypoint x="670" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_bronze_store_di" bpmnElement="Flow_bronze_store">
        <di:waypoint x="780" y="260" /><di:waypoint x="830" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_store_silver_task_di" bpmnElement="Flow_store_silver_task">
        <di:waypoint x="910" y="290" /><di:waypoint x="940" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_silver_store_di" bpmnElement="Flow_silver_store">
        <di:waypoint x="1050" y="380" /><di:waypoint x="1100" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_clean_gold_di" bpmnElement="Flow_clean_gold">
        <di:waypoint x="1180" y="410" /><di:waypoint x="1220" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_gold_store_di" bpmnElement="Flow_gold_store">
        <di:waypoint x="1100" y="500" /><di:waypoint x="990" y="500" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_store_end_di" bpmnElement="Flow_store_end">
        <di:waypoint x="910" y="530" /><di:waypoint x="910" y="602" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_ckpt_silver_di" bpmnElement="Assoc_ckpt_silver">
        <di:waypoint x="670" y="380" /><di:waypoint x="830" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Assoc_note_gold_di" bpmnElement="Assoc_note_gold">
        <di:waypoint x="1120" y="615" /><di:waypoint x="1220" y="540" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
