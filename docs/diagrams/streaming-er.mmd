  KAFKA_NETWORK_EVENTS {
    string event_id PK
    string phone_number
    string device_id
    string network_type
    float rsrp
    float sinr
    float latitude
    float longitude
    string event_time
  }

  BRONZE_NETWORK_EVENTS_RAW {
    string event_id PK
    string phone_number
    string device_id
