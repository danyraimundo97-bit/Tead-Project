    string pipeline_name PK
    string last_silver_watermark
    string updated_at
  }

  SILVER_NETWORK_EVENTS_CLEAN {
    string event_id PK
    string phone_number
    string device_id
    string network_type
    float rsrp
    float sinr
    float latitude
    float longitude
    string event_time
    string ingested_at
  }

  GOLD_NETWORK_EVENTS_HOURLY {
    string bucket_hour PK
    string network_type PK
    int event_count
