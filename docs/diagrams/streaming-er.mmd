erDiagram
  KAFKA_NETWORK_EVENTS ||--o{ BRONZE_NETWORK_EVENTS_RAW : "0..N por event_id"
  BRONZE_NETWORK_EVENTS_RAW ||--o| SILVER_NETWORK_EVENTS_CLEAN : "0..1 por event_id"
