<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_batch_jdpt" targetNamespace="http://jdpt.pt/bpmn/batch" exporter="Camunda Modeler" exporterVersion="5.47.0">
  <bpmn:process id="Process_jdpt_lakehouse_pipeline" name="jdpt_lakehouse_pipeline" isExecutable="false">
    <bpmn:documentation>Pipeline batch Flyte — reconstrução manual Silver + Gold. Limpeza numérica, circuit breaker 5% e quarentena Iceberg.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_batch">
      <bpmn:lane id="Layer_ops" name="Layer: Operação">
        <bpmn:flowNodeRef>StartEvent_manual</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Layer_prep_silver" name="Layer: Preparação Silver">
        <bpmn:flowNodeRef>Task_ensure_silver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Layer_bronze_silver" name="Layer: Bronze → Silver (paralelo)">
        <bpmn:flowNodeRef>Gateway_fork_silver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_process_cdr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_process_logs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_process_tests</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_process_towers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join_silver</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Layer_quarantine" name="Layer: Quarentena Silver">
        <bpmn:flowNodeRef>Task_q_cdr</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_q_logs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_q_tests</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_q_towers</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Layer_qa_silver" name="Layer: Qualidade Silver">
        <bpmn:flowNodeRef>Task_avaliar_silver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_silver_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_silver_fail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Layer_prep_gold" name="Layer: Preparação Gold">
        <bpmn:flowNodeRef>Task_ensure_gold</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Layer_silver_gold" name="Layer: Silver → Gold (paralelo)">
        <bpmn:flowNodeRef>Gateway_fork_gold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_build_network</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_build_churn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_join_gold</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Layer_qa_gold" name="Layer: Qualidade Gold">
        <bpmn:flowNodeRef>Task_avaliar_gold</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_gold_ok</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_gold_fail</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Layer_consumo" name="Layer: Consumo">
        <bpmn:flowNodeRef>EndEvent_success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_manual" name="Disparo manual via Flyte">
      <bpmn:outgoing>Flow_start_envS</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_ensure_silver" name="ensure_silver_layer_environment">
      <bpmn:documentation>MinIO bronze + DDL Iceberg silver (incl. *_quarantine_raw / *_quarantine_audit)</bpmn:documentation>
      <bpmn:incoming>Flow_start_envS</bpmn:incoming>
      <bpmn:outgoing>Flow_envS_fork</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_fork_silver" name="Fork">
      <bpmn:incoming>Flow_envS_fork</bpmn:incoming>
      <bpmn:outgoing>Flow_042sbk0</bpmn:outgoing>
      <bpmn:outgoing>Flow_1cs85zj</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_process_cdr" name="process_cdr_to_silver">
      <bpmn:documentation>Limpeza + circuit breaker 5% + quarentena + ACID → cdr_customers</bpmn:documentation>
      <bpmn:incoming>Flow_042sbk0</bpmn:incoming>
      <bpmn:outgoing>Flow_1yp95ke</bpmn:outgoing>
      <bpmn:outgoing>Flow_0z5689c</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_process_logs" name="process_logs_to_silver">
      <bpmn:documentation>Limpeza + circuit breaker 5% + quarentena + ACID → network_logs</bpmn:documentation>
      <bpmn:incoming>Flow_1cs85zj</bpmn:incoming>
      <bpmn:outgoing>Flow_10v7hoj</bpmn:outgoing>
      <bpmn:outgoing>Flow_0z5xpfp</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_process_tests" name="process_call_tests_to_silver">
      <bpmn:documentation>Limpeza + circuit breaker 5% + quarentena + ACID → call_tests</bpmn:documentation>
      <bpmn:incoming>Flow_0z5689c</bpmn:incoming>
      <bpmn:outgoing>Flow_1saot63</bpmn:outgoing>
      <bpmn:outgoing>Flow_0tc5g2q</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_process_towers" name="process_towers_to_silver">
      <bpmn:documentation>Limpeza + circuit breaker 5% + quarentena + ACID → towers</bpmn:documentation>
      <bpmn:incoming>Flow_0z5xpfp</bpmn:incoming>
      <bpmn:outgoing>Flow_0wbfu0u</bpmn:outgoing>
      <bpmn:outgoing>Flow_1dhfehk</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_q_cdr" name="cdr_quarantine_raw + audit">
      <bpmn:documentation>iceberg.silver.cdr_quarantine_raw / cdr_quarantine_audit</bpmn:documentation>
      <bpmn:incoming>Flow_10v7hoj</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_q_logs" name="network_logs_quarantine_raw + audit">
      <bpmn:documentation>iceberg.silver.network_logs_quarantine_raw / network_logs_quarantine_audit</bpmn:documentation>
      <bpmn:incoming>Flow_1yp95ke</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_q_tests" name="call_tests_quarantine_raw + audit">
      <bpmn:documentation>iceberg.silver.call_tests_quarantine_raw / call_tests_quarantine_audit</bpmn:documentation>
      <bpmn:incoming>Flow_0wbfu0u</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Task_q_towers" name="towers_quarantine_raw + audit">
      <bpmn:documentation>iceberg.silver.towers_quarantine_raw / towers_quarantine_audit</bpmn:documentation>
      <bpmn:incoming>Flow_0tc5g2q</bpmn:incoming>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_join_silver">
      <bpmn:incoming>Flow_1dhfehk</bpmn:incoming>
      <bpmn:incoming>Flow_1saot63</bpmn:incoming>
      <bpmn:outgoing>Flow_1ublejk</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_avaliar_silver" name="avaliar_silver">
      <bpmn:documentation>Auditoria em log (não bloqueia)</bpmn:documentation>
      <bpmn:incoming>Flow_1ublejk</bpmn:incoming>
      <bpmn:outgoing>Flow_evalS_gw</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_silver_ok" name="Tasks Silver OK?" default="Flow_silver_fail">
      <bpmn:incoming>Flow_evalS_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_silver_ok</bpmn:outgoing>
      <bpmn:outgoing>Flow_silver_fail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_silver_fail" name="Pipeline bloqueado">
      <bpmn:incoming>Flow_silver_fail</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Task_ensure_gold" name="ensure_gold_layer_environment">
      <bpmn:documentation>DDL gold + partitioning Iceberg</bpmn:documentation>
      <bpmn:incoming>Flow_silver_ok</bpmn:incoming>
      <bpmn:outgoing>Flow_1spfh71</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_fork_gold" name="Fork">
      <bpmn:incoming>Flow_1spfh71</bpmn:incoming>
      <bpmn:outgoing>Flow_17o0o4e</bpmn:outgoing>
      <bpmn:outgoing>Flow_1yfnkbx</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_build_network" name="build_gold_network_quality">
      <bpmn:documentation>Produto A — network_quality_daily (ACID)</bpmn:documentation>
      <bpmn:incoming>Flow_17o0o4e</bpmn:incoming>
      <bpmn:outgoing>Flow_1y4qyyx</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_build_churn" name="build_gold_churn_risk">
      <bpmn:documentation>Produto B — churn_risk_daily (ACID)</bpmn:documentation>
      <bpmn:incoming>Flow_1yfnkbx</bpmn:incoming>
      <bpmn:outgoing>Flow_0tub4cd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="Gateway_join_gold">
      <bpmn:incoming>Flow_1y4qyyx</bpmn:incoming>
      <bpmn:incoming>Flow_0tub4cd</bpmn:incoming>
      <bpmn:outgoing>Flow_0o22q2o</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_avaliar_gold" name="avaliar_gold">
      <bpmn:documentation>Auditoria em log (não bloqueia)</bpmn:documentation>
      <bpmn:incoming>Flow_0o22q2o</bpmn:incoming>
      <bpmn:outgoing>Flow_evalG_gw</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="Gateway_gold_ok" name="Tasks Gold OK?">
      <bpmn:incoming>Flow_evalG_gw</bpmn:incoming>
      <bpmn:outgoing>Flow_0fpbzao</bpmn:outgoing>
      <bpmn:outgoing>Flow_19r6ecj</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_gold_fail" name="Pipeline bloqueado">
      <bpmn:incoming>Flow_0fpbzao</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_success" name="Snapshot Gold disponível">
      <bpmn:incoming>Flow_19r6ecj</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_envS" sourceRef="StartEvent_manual" targetRef="Task_ensure_silver" />
    <bpmn:sequenceFlow id="Flow_envS_fork" sourceRef="Task_ensure_silver" targetRef="Gateway_fork_silver" />
    <bpmn:sequenceFlow id="Flow_evalS_gw" sourceRef="Task_avaliar_silver" targetRef="Gateway_silver_ok" />
    <bpmn:sequenceFlow id="Flow_silver_ok" name="Sim" sourceRef="Gateway_silver_ok" targetRef="Task_ensure_gold" />
    <bpmn:sequenceFlow id="Flow_silver_fail" name="Não" sourceRef="Gateway_silver_ok" targetRef="EndEvent_silver_fail" />
    <bpmn:sequenceFlow id="Flow_evalG_gw" sourceRef="Task_avaliar_gold" targetRef="Gateway_gold_ok" />
    <bpmn:sequenceFlow id="Flow_042sbk0" sourceRef="Gateway_fork_silver" targetRef="Task_process_cdr" />
    <bpmn:sequenceFlow id="Flow_1cs85zj" sourceRef="Gateway_fork_silver" targetRef="Task_process_logs" />
    <bpmn:sequenceFlow id="Flow_10v7hoj" sourceRef="Task_process_logs" targetRef="Task_q_cdr" />
    <bpmn:sequenceFlow id="Flow_1yp95ke" sourceRef="Task_process_cdr" targetRef="Task_q_logs" />
    <bpmn:sequenceFlow id="Flow_0wbfu0u" sourceRef="Task_process_towers" targetRef="Task_q_tests" />
    <bpmn:sequenceFlow id="Flow_1dhfehk" sourceRef="Task_process_towers" targetRef="Gateway_join_silver" />
    <bpmn:sequenceFlow id="Flow_1saot63" sourceRef="Task_process_tests" targetRef="Gateway_join_silver" />
    <bpmn:sequenceFlow id="Flow_0z5689c" sourceRef="Task_process_cdr" targetRef="Task_process_tests" />
    <bpmn:sequenceFlow id="Flow_0z5xpfp" sourceRef="Task_process_logs" targetRef="Task_process_towers" />
    <bpmn:sequenceFlow id="Flow_0tc5g2q" sourceRef="Task_process_tests" targetRef="Task_q_towers" />
    <bpmn:sequenceFlow id="Flow_1ublejk" sourceRef="Gateway_join_silver" targetRef="Task_avaliar_silver" />
    <bpmn:sequenceFlow id="Flow_1spfh71" sourceRef="Task_ensure_gold" targetRef="Gateway_fork_gold" />
    <bpmn:sequenceFlow id="Flow_1y4qyyx" sourceRef="Task_build_network" targetRef="Gateway_join_gold" />
    <bpmn:sequenceFlow id="Flow_0tub4cd" sourceRef="Task_build_churn" targetRef="Gateway_join_gold" />
    <bpmn:sequenceFlow id="Flow_17o0o4e" sourceRef="Gateway_fork_gold" targetRef="Task_build_network" />
    <bpmn:sequenceFlow id="Flow_1yfnkbx" sourceRef="Gateway_fork_gold" targetRef="Task_build_churn" />
    <bpmn:sequenceFlow id="Flow_0o22q2o" sourceRef="Gateway_join_gold" targetRef="Task_avaliar_gold" />
    <bpmn:sequenceFlow id="Flow_0fpbzao" sourceRef="Gateway_gold_ok" targetRef="EndEvent_gold_fail" />
    <bpmn:sequenceFlow id="Flow_19r6ecj" sourceRef="Gateway_gold_ok" targetRef="EndEvent_success" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_batch">
    <bpmndi:BPMNPlane id="BPMNPlane_batch" bpmnElement="Process_jdpt_lakehouse_pipeline">
